{
  "name": "ametller-cli-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Promoción local de ametller-cli con Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3100",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts AmetllerPromo out/ametller-cli-promo.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=2",
    "poster": "remotion still src/index.ts AmetllerPromo out/poster.png --frame=130"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@remotion/cli": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
